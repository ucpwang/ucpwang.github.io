---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="검색 — Jacob.c" description="블로그 포스트를 검색합니다." pagefindIgnore={true}>
  <link slot="head" href="/pagefind/pagefind-ui.css" rel="stylesheet" />

  <div class="container search-page">
    <h1 class="search-page__title">검색</h1>
    <div id="search"></div>
  </div>
</BaseLayout>

<script>
  const script = document.createElement('script');
  script.src = '/pagefind/pagefind-ui.js';
  script.onload = () => {
    // @ts-ignore
    new PagefindUI({
      element: '#search',
      showImages: false,
      resetStyles: false,
    });

    // pagefind가 Svelte 스코프 선택자로 CSS 특이도를 높이므로,
    // 다크 테마 색상을 JS로 직접 주입
    const overrideStyle = document.createElement('style');
    const s = getComputedStyle(document.documentElement);
    const textPrimary = s.getPropertyValue('--color-text-primary').trim();
    const bgElevated = s.getPropertyValue('--color-bg-elevated').trim();
    const bgBase = s.getPropertyValue('--color-bg-base').trim();
    const brand = s.getPropertyValue('--color-brand').trim();
    const textMuted = s.getPropertyValue('--color-text-muted').trim();
    overrideStyle.textContent = `
      .pagefind-ui__search-input { color: ${textPrimary} !important; background-color: ${bgElevated} !important; }
      .pagefind-ui__search-clear { color: ${textMuted} !important; background-color: ${bgElevated} !important; border: none !important; }
      .pagefind-ui__search-clear:hover { color: ${textPrimary} !important; background-color: ${bgElevated} !important; }
    `;
    document.head.appendChild(overrideStyle);

    // "비우기" → "×"
    const searchEl = document.getElementById('search');
    if (searchEl) {
      const observer = new MutationObserver(() => {
        const btn = searchEl.querySelector('.pagefind-ui__search-clear');
        if (btn && btn.textContent?.trim() !== '×') {
          btn.textContent = '×';
          btn.setAttribute('aria-label', '검색 지우기');
        }
      });
      observer.observe(searchEl, { childList: true, subtree: true });
    }
  };
  document.head.appendChild(script);
</script>

<style>
  .search-page {
    padding-top: var(--space-12);
    padding-bottom: var(--space-24);
  }

  .search-page__title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-8);
  }

  /* Pagefind UI 다크 테마 CSS 변수 — 텍스트/배경색은 JS override로 처리 */
  :global(#search) {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--color-brand);
    --pagefind-ui-text: var(--color-text-primary);
    --pagefind-ui-background: var(--color-bg-base);
    --pagefind-ui-border: var(--color-border);
    --pagefind-ui-tag: var(--color-bg-elevated);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 12px;
    --pagefind-ui-font: var(--font-body);
  }

  :global(.pagefind-ui__search-input:focus) {
    border-color: var(--color-brand) !important;
    outline: none !important;
  }

  :global(.pagefind-ui__result) {
    border-color: var(--color-border) !important;
    padding: var(--space-5) 0 !important;
  }

  :global(.pagefind-ui__result-title a) {
    color: var(--color-text-primary) !important;
    text-decoration: none !important;
    font-weight: var(--font-semibold) !important;
    font-size: var(--text-lg) !important;
  }

  :global(.pagefind-ui__result-title a:hover) {
    color: var(--color-brand) !important;
  }

  :global(.pagefind-ui__result-excerpt) {
    color: var(--color-text-secondary) !important;
    font-size: var(--text-sm) !important;
    margin-top: var(--space-2) !important;
  }

  :global(.pagefind-ui__result-excerpt mark) {
    background: rgba(192, 192, 192, 0.15) !important;
    color: var(--color-brand) !important;
    border-radius: 3px !important;
    padding: 0 2px !important;
  }

  :global(.pagefind-ui__message) {
    color: var(--color-text-muted) !important;
    font-size: var(--text-sm) !important;
  }
</style>
