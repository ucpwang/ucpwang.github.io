---
import { getCollection } from 'astro:content';
import { tagToSlug } from '../../utils/tag';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const tagCounts = posts
  .flatMap((p) => p.data.tags)
  .reduce<Record<string, number>>((acc, tag) => {
    acc[tag] = (acc[tag] ?? 0) + 1;
    return acc;
  }, {});

const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="블로그 — Jacob.c" description="Jacob.c의 블로그 포스트 목록입니다.">
  <section class="container blog-index">
    <h1 class="blog-index__title">블로그</h1>
    <p class="blog-index__count">{posts.length}개의 포스트</p>

    {
      sortedTags.length > 0 && (
        <div class="tag-cloud">
          {sortedTags.map(([tag, count]) => (
            <a href={`/blog/tag/${tagToSlug(tag)}`} class="tag-cloud__item">
              {tag}
              <span class="tag-cloud__count">{count}</span>
            </a>
          ))}
        </div>
      )
    }

    {
      posts.length > 0 ? (
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <PostCard
                title={post.data.title}
                date={post.data.date}
                description={post.data.description}
                slug={post.slug}
                tags={post.data.tags}
              />
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-state">아직 작성된 포스트가 없습니다.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .blog-index {
    padding-top: var(--space-12);
    padding-bottom: var(--space-24);
  }

  .blog-index__title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-2);
  }

  .blog-index__count {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  /* 태그 클라우드 */
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-10);
    padding: var(--space-5);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .tag-cloud__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background var(--transition-fast);
  }

  .tag-cloud__item:hover {
    color: var(--color-brand);
    border-color: var(--color-brand);
    background: var(--color-bg-base);
  }

  .tag-cloud__count {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .empty-state {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
