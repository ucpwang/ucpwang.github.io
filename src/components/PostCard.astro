---
import { tagToSlug } from '../utils/tag';

interface Props {
  title: string;
  date: Date;
  description: string;
  slug: string;
  tags?: string[];
}

const { title, date, description, slug, tags = [] } = Astro.props;

const formattedDate = date.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="post-card">
  <a href={`/blog/${slug}`} class="post-card__link">
    <time class="post-card__date" datetime={date.toISOString()}>{formattedDate}</time>
    <h2 class="post-card__title">{title}</h2>
    <p class="post-card__desc">{description}</p>
  </a>
  {
    tags.length > 0 && (
      <ul class="post-card__tags">
        {tags.map((tag) => (
          <li>
            <a href={`/blog/tag/${tagToSlug(tag)}`} class="post-card__tag">
              {tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .post-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-base);
    overflow: hidden;
    transition:
      border-color var(--transition-base),
      box-shadow var(--transition-base),
      transform var(--transition-base);
    will-change: transform;
  }

  .post-card:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-convex);
    transform: translateY(-3px);
  }

  .post-card__link {
    display: block;
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
  }

  .post-card__date {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .post-card__title {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
    transition: color var(--transition-fast);
  }

  .post-card:hover .post-card__title {
    color: var(--color-brand);
  }

  .post-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0 var(--space-6) var(--space-5);
    list-style: none;
  }

  .post-card__tag {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: var(--space-1) var(--space-3);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .post-card__tag:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }
</style>
