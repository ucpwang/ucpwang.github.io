---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import '../styles/prose.css';

interface Props {
  post: CollectionEntry<'blog'>;
  rawContent?: string;
}

const { post, rawContent = '' } = Astro.props;
const { title, date, description, tags } = post.data;

const formattedDate = date.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const wordCount = rawContent
  .replace(/[^\S\n]+/g, ' ')
  .split(/\s+/)
  .filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<BaseLayout title={title} description={description}>
  <!-- 읽기 진행 바 -->
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

  <article class="container post">
    <header class="post__header">
      <div class="post__meta">
        <time class="post__date" datetime={date.toISOString()}>{formattedDate}</time>
        <span class="post__meta-sep">·</span>
        <span class="post__reading-time">읽기 {readingTime}분</span>
      </div>
      <h1 class="post__title">{title}</h1>
      <p class="post__description">{description}</p>
      {
        tags && tags.length > 0 && (
          <ul class="post__tags">
            {tags.map((tag) => (
              <li class="post__tag">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="post__footer">
      <a href="/blog" class="post__back-link">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M10 3L5 8L10 13"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        목록으로
      </a>
    </footer>
  </article>
</BaseLayout>

<script>
  const bar = document.getElementById('reading-progress');
  if (bar) {
    window.addEventListener(
      'scroll',
      () => {
        const doc = document.documentElement;
        const scrolled = doc.scrollTop / (doc.scrollHeight - doc.clientHeight);
        bar.style.width = `${Math.min(100, scrolled * 100)}%`;
      },
      { passive: true }
    );
  }
</script>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0%;
    background: var(--color-brand);
    z-index: 100;
    transition: width 0.1s linear;
  }

  .post {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
  }

  .post__header {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .post__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .post__date,
  .post__reading-time {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .post__meta-sep {
    color: var(--color-border-strong);
    font-size: var(--text-sm);
  }

  .post__title {
    font-size: var(--text-4xl);
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }

  .post__description {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-5);
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }

  .post__tag {
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: var(--space-1) var(--space-3);
    color: var(--color-text-secondary);
  }

  .post__footer {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .post__back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition:
      color var(--transition-fast),
      gap var(--transition-fast);
  }

  .post__back-link:hover {
    color: var(--color-text-primary);
    gap: var(--space-3);
  }
</style>
