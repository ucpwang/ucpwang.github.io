---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import '../styles/prose.css';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, date, description, tags } = post.data;

const formattedDate = date.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description}>
  <article class="container post">
    <header class="post__header">
      <time class="post__date" datetime={date.toISOString()}>{formattedDate}</time>
      <h1 class="post__title">{title}</h1>
      <p class="post__description">{description}</p>
      {
        tags && tags.length > 0 && (
          <ul class="post__tags">
            {tags.map((tag) => (
              <li class="post__tag">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>
    <div class="prose">
      <slot />
    </div>
    <footer class="post__footer">
      <a href="/blog" class="post__back-link">← 목록으로</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
  }

  .post__header {
    margin-bottom: var(--space-10);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .post__date {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .post__title {
    font-size: var(--text-4xl);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-4);
  }

  .post__description {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin-top: var(--space-4);
  }

  .post__tag {
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: var(--space-1) var(--space-3);
    color: var(--color-text-secondary);
  }

  .post__footer {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .post__back-link {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .post__back-link:hover {
    color: var(--color-text-primary);
  }
</style>
